# macOS
.DS_Store

# SwiftPM / Xcode build output
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcresult
*.xcodeproj
!ios/CodaIOS.xcodeproj

# Generated by Scripts/configure-ios.sh --carplay (opt-in CarPlay overlay)
Sources/iOS&iPadOS/Config/CarPlay.local.xcconfig
Sources/iOS&iPadOS/Config/Generated/

# Distribution artifacts
dist/
*.ipa
*.dSYM/

# Local credentials and device config (template: .env.example)
.env
.env.local
*.p12
*.mobileprovision

# Local editor / agent settings
.claude/settings.local.json
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]

# Raw screen recordings (source material for Scripts/make-*-video.swift)
docs/assets/recordings/

# Unused screenshot / video candidates kept locally (not referenced by README or site)
docs/assets/unused/
# Generated by Scripts/frame-screenshots.py, not used by the site
site/assets/screenshots/mac/frame.png

# Local env-gated probe tests (PROBE_AUDIO), not part of the suite
Tests/**/ZZProbe*Tests.swift
