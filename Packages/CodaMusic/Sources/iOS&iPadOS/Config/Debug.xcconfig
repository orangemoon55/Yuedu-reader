// Debug.xcconfig
// Debug configuration for iOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

// Keep physical-device Debug installs compatible with iPadOS 16's loader.
// A separate .debug.dylib was rejected at launch with a code-signature error.
// Simulator builds retain the debug dylib for SwiftUI previews.
ENABLE_DEBUG_DYLIB[sdk=iphoneos*] = NO